{
  "sourceLanguage": "en",
  "strings": {
    "discover.action.close": {
      "comment": "Closes the animal profile sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        }
      }
    },
    "discover.action.details": {
      "comment": "Opens the animal profile",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See profile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver ficha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir la fiche"
          }
        }
      }
    },
    "discover.action.like": {
      "comment": "Like button and VoiceOver action",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm interested"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me interesa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça m'intéresse"
          }
        }
      }
    },
    "discover.action.pass": {
      "comment": "Pass button and VoiceOver action",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not for me"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es para mí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas pour moi"
          }
        }
      }
    },
    "discover.distance %@": {
      "comment": "Distance to the shelter. %@ = formatted distance (e.g. 12 km)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ away"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À %@"
          }
        }
      }
    },
    "discover.empty.message": {
      "comment": "Empty state message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back soon: shelters add new companions every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve pronto: los refugios añaden nuevos compañeros cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez bientôt : les refuges ajoutent de nouveaux compagnons chaque jour."
          }
        }
      }
    },
    "discover.empty.title": {
      "comment": "Empty state title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more animals for now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay más animales por ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus d'animaux pour le moment"
          }
        }
      }
    },
    "discover.error.retry": {
      "comment": "Retry button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "discover.error.title": {
      "comment": "Error state title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur est survenue"
          }
        }
      }
    },
    "discover.loading": {
      "comment": "Loading message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding companions near you…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando compañeros cerca de ti…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de compagnons près de chez vous…"
          }
        }
      }
    },
    "discover.match.continue": {
      "comment": "Button closing the confirmation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep discovering"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir descubriendo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer à découvrir"
          }
        }
      }
    },
    "discover.match.coolingOff %lld": {
      "comment": "Legal notice. %lld = number of days of the mandatory reflection period",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A legal reflection period of %lld day applies before adoption."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A legal reflection period of %lld days applies before adoption."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se aplica un periodo legal de reflexión de %lld día antes de la adopción."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se aplica un periodo legal de reflexión de %lld días antes de la adopción."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un délai de réflexion légal de %lld jour s'applique avant l'adoption."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un délai de réflexion légal de %lld jours s'applique avant l'adoption."
                }
              }
            }
          }
        }
      }
    },
    "discover.match.message %@ %@": {
      "comment": "Confirmation message. %1$@ = shelter name, %2$@ = animal name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has been notified of your interest in %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El refugio «%1$@» ha sido informado de tu interés por %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le refuge « %1$@ » a été informé de votre intérêt pour %2$@."
          }
        }
      }
    },
    "discover.match.title": {
      "comment": "Confirmation after liking an animal",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request sent!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Solicitud enviada!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande envoyée !"
          }
        }
      }
    },
    "discover.title": {
      "comment": "Navigation title of the swipe screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubrir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrir"
          }
        }
      }
    }
  },
  "version": "1.0"
}
