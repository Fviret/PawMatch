    "compatibility.energyMatch": {
      "comment": "Compatibility highlight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches your lifestyle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaja con tu estilo de vida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspond à votre rythme de vie"
          }
        }
      }
    },
    "compatibility.energyMismatch": {
      "comment": "Compatibility warning",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy level differs from yours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel de energía distinto al tuyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau d'énergie différent du vôtre"
          }
        }
      }
    },
    "compatibility.getsAlongWithPets": {
      "comment": "Compatibility highlight: the animal gets along with the adopter's pets",
      "extractionState": "manual",
