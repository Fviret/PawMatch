    "matches.empty.message": {
      "comment": "Empty state message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show interest in an animal to contact its shelter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra interés por un animal para contactar con su refugio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez votre intérêt pour un animal pour contacter son refuge."
          }
        }
      }
    },
    "matches.empty.title": {
      "comment": "Empty state title",
      "extractionState": "manual",
      "localizations": {
